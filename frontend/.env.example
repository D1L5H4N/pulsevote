# ============================================================
# PulseVote Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# Variables MUST start with VITE_ to be exposed to the browser.
# ============================================================

# Backend API base URL
# Development: leave empty (Vite proxy handles it)
# Production (Render): https://your-backend.onrender.com
VITE_API_URL=

# Backend WebSocket base URL
# Development: leave empty (Vite proxy handles it)
# Production (Render): wss://your-backend.onrender.com
VITE_WS_URL=
