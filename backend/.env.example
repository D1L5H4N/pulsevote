# ============================================================
# PulseVote Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=8080

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# MongoDB database name
DB_NAME=pulsevote

# JWT secret — use a long, random string in production
# Generate: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Upstash Redis connection string (TLS)
# Format: rediss://default:<password>@<host>:<port>
REDIS_URL=rediss://default:password@your-upstash-endpoint.upstash.io:6379

# Redis password (extracted from URL for go-redis ParseURL)
# Usually same as password in REDIS_URL
REDIS_PASSWORD=your-redis-password

# Frontend URL for CORS (Vercel deployment URL or localhost for dev)
FRONTEND_URL=http://localhost:5173
